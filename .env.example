# Copier vers .env (jamais commité). Valeurs de développement local uniquement.
POSTGRES_USER=monrepo
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=monrepo
DATABASE_URL=postgres://monrepo:change-me-locally@localhost:5432/monrepo
# Port hôte de Postgres (changez-le si 5432 est déjà pris)
DB_PORT=5432
API_PORT=3001
WEB_PORT=3000
# Auth de développement uniquement (jamais en production) : active l’en-tête X-Account-Id
DEV_AUTH=false
# Derrière un proxy de confiance (Fly) : limite de débit par IP cliente
TRUST_PROXY=false
# Fournisseur de paiement : none (checkout 503), fake (local uniquement, refusé en production) ou stripe
PAYMENT_PROVIDER=none
# Stripe (PAYMENT_PROVIDER=stripe) : clés de test en local, secrets Fly en production, jamais dans le dépôt
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# E-mails : none (aucun envoi) ou console (local uniquement, écrit les codes cadeau en clair, refusé en production)
MAILER=none
