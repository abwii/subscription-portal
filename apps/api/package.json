{
  "name": "@subscription-portal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db-cli.ts migrate",
    "db:seed": "tsx src/db-cli.ts seed",
    "jobs:expire-pending": "tsx src/jobs-cli.ts expire-pending",
    "jobs:resume": "tsx src/jobs-cli.ts resume",
    "jobs:close-ended": "tsx src/jobs-cli.ts close-ended",
    "jobs:renew": "tsx src/jobs-cli.ts renew"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@subscription-portal/config": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
